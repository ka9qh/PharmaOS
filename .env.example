# Never commit real values.  Configure these in CI, Supabase secrets, or the
# deployment environment.  Public Supabase publishable keys are not secrets,
# but they must still be protected by RLS.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_TOKEN_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/livekit-token
